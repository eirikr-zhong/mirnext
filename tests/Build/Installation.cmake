cmake_minimum_required(VERSION 3.14)
file(MAKE_DIRECTORY "${WORK}/source" "${WORK}/outside")
file(WRITE "${WORK}/source/payload.txt" "native install fixture\n")
file(WRITE "${WORK}/source/CMakeLists.txt" "cmake_minimum_required(VERSION 3.14)\nproject(ReceiptFixture LANGUAGES NONE)\ninstall(FILES payload.txt DESTINATION share/mirnext-test)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}/source" -B "${WORK}/build" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Installation fixture configure failed")
endif()
function(install_fixture prefix staging)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DBINARY_DIR=${WORK}/build" "-DPREFIX=${prefix}" "-DSTAGING_ROOT=${staging}"
    -P "${SOURCE_DIR}/cmake/Install.cmake" WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Fixture installation failed: ${status}: ${output}: ${error}")
  endif()
endfunction()
function(uninstall_fixture receipt succeeds diagnostic)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DRECEIPT=${receipt}" -P "${SOURCE_DIR}/cmake/Uninstall.cmake"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(succeeds AND NOT status EQUAL 0)
    message(FATAL_ERROR "Fixture uninstall failed: ${status}: ${output}: ${error}")
  elseif(NOT succeeds AND (status EQUAL 0 OR NOT error MATCHES "${diagnostic}"))
    message(FATAL_ERROR "Invalid receipt was not diagnosed: ${status}: ${output}: ${error}")
  endif()
endfunction()
set(prefix "${WORK}/plain prefix")
install_fixture("${prefix}" "")
set(receipt "${WORK}/build/mirnext-install-receipt.txt")
if(NOT EXISTS "${prefix}/share/mirnext-test/payload.txt")
  message(FATAL_ERROR "Installed fixture is missing")
endif()
file(WRITE "${prefix}/unrelated.txt" "retain this file\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DBINARY_DIR=${WORK}/build" "-DPREFIX=${WORK}/different prefix"
  -P "${SOURCE_DIR}/cmake/Install.cmake" RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_VARIABLE output)
if(status EQUAL 0 OR NOT error MATCHES "previous native installation" OR EXISTS "${WORK}/different prefix/share/mirnext-test/payload.txt")
  message(FATAL_ERROR "Changing destination lost ownership of an existing installation: ${status}: ${error}")
endif()
# Install a changed file set in the same prefix, as when installing multiple
# configurations or a newer header set. Earlier owned files must remain tracked.
file(WRITE "${WORK}/source/payload-two.txt" "another native fixture\n")
file(WRITE "${WORK}/source/CMakeLists.txt" "cmake_minimum_required(VERSION 3.14)\nproject(ReceiptFixture LANGUAGES NONE)\ninstall(FILES payload-two.txt DESTINATION share/mirnext-test)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}/source" -B "${WORK}/build" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Changed installation fixture configure failed")
endif()
install_fixture("${prefix}" "")
uninstall_fixture("${receipt}" TRUE "")
if(EXISTS "${prefix}/share/mirnext-test/payload.txt" OR EXISTS "${prefix}/share/mirnext-test/payload-two.txt" OR NOT EXISTS "${prefix}/unrelated.txt")
  message(FATAL_ERROR "Uninstall did not preserve unrelated files")
endif()
uninstall_fixture("${receipt}" TRUE "")
if(NOT WIN32)
  install_fixture("/opt/mirnext-receipt-test" "${WORK}/staging root")
  set(staged "${WORK}/staging root/opt/mirnext-receipt-test/share/mirnext-test/payload-two.txt")
  if(NOT EXISTS "${staged}")
    message(FATAL_ERROR "DESTDIR fixture is missing")
  endif()
  uninstall_fixture("${receipt}" TRUE "")
  if(EXISTS "${staged}")
    message(FATAL_ERROR "DESTDIR uninstall used the logical rather than recorded prefix")
  endif()
  install_fixture("/opt/mirnext-receipt-test" "relative staging root")
  set(staged "${WORK}/relative staging root/opt/mirnext-receipt-test/share/mirnext-test/payload-two.txt")
  if(NOT EXISTS "${staged}")
    message(FATAL_ERROR "Relative DESTDIR fixture is missing")
  endif()
  uninstall_fixture("${receipt}" TRUE "")
  if(EXISTS "${staged}")
    message(FATAL_ERROR "Relative DESTDIR uninstall missed the recorded file")
  endif()
endif()

# Every invalid entry must fail before even the first valid file is removed.
file(WRITE "${prefix}/owned.txt" "retain until preflight succeeds\n")
file(WRITE "${WORK}/outside/victim.txt" "never remove this file\n")
function(reject_entry entry diagnostic)
  file(WRITE "${WORK}/invalid-receipt.txt" "MIRNext install receipt v1\n${prefix}\n${prefix}/owned.txt\n${entry}\n")
  uninstall_fixture("${WORK}/invalid-receipt.txt" FALSE "${diagnostic}")
  if(NOT EXISTS "${prefix}/owned.txt" OR NOT EXISTS "${WORK}/outside/victim.txt")
    message(FATAL_ERROR "Invalid receipt caused partial or outside deletion")
  endif()
endfunction()
reject_entry("${WORK}/outside/victim.txt" "outside its prefix")
reject_entry("${prefix}/../outside/victim.txt" "outside its prefix")
reject_entry("relative-file" "relative path")
reject_entry("${prefix}/share" "not directories")
reject_entry("${prefix}/malformed;path" "Invalid characters")
if(NOT WIN32)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E create_symlink "${WORK}/outside" "${prefix}/escape" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Could not create symlink regression fixture")
  endif()
  reject_entry("${prefix}/escape/victim.txt" "parent escapes")
  # A final-component symlink is removed itself without following its target.
  file(WRITE "${WORK}/link-receipt.txt" "MIRNext install receipt v1\n${prefix}\n${prefix}/escape\n")
  uninstall_fixture("${WORK}/link-receipt.txt" TRUE "")
  if(IS_SYMLINK "${prefix}/escape" OR NOT EXISTS "${WORK}/outside/victim.txt")
    message(FATAL_ERROR "Uninstall followed an installed symlink")
  endif()
endif()
uninstall_fixture("${WORK}/not-present-receipt" FALSE "No native installation receipt")
file(WRITE "${WORK}/bad-header.txt" "unknown format\n${prefix}\n")
uninstall_fixture("${WORK}/bad-header.txt" FALSE "Unknown native installation receipt")
message(STATUS "Native installation receipts, staging, repeated uninstall and preflight isolation passed")
