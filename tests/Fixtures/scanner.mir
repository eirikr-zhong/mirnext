
m_loop: module
loop:   func i64, i64:limit # a comment

        local i64:count
        mov count, 0
        bge L1, count, limit
L2:     # a separate label
        add count, count, 1; blt L2, count, limit # 2 insn on a line
L1:     ret count  # label with insn
        endfunc
        endmodule

m_sieve: module
sieve:   func i64
         local i64:iter, i64:count, i64:i, i64:k, i64:prime, i64:temp, i64:flags
         alloca flags, 819000
         mov iter, 0
loop:    bge fin, iter, 1000
         mov count, 0;  mov i, 0
loop2:   bgt fin2, i, 819000
         mov u8:(flags, i)::noalias1, 1;  add i, i, 1
         jmp loop2
fin2:    mov i, 0
loop3:   bgt fin3, i, 819000
         beq cont3, u8:(flags,i):alias, 0
         add temp, i, i;  add prime, temp, 3;  add k, i, prime
loop4:   bgt fin4, k, 819000
         mov u8:(flags, k):alias:noalias2, 0;  add k, k, prime
         jmp loop4
fin4:    add count, count, 1
cont3:   add i, i, 1
         jmp loop3
fin3:    add iter, iter, 1
         jmp loop
fin:     ret count
         endfunc
         endmodule
