execute_process(COMMAND "${PROBE}" success RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT error STREQUAL "")
  message(FATAL_ERROR "Successful Result expression was not evaluated once: ${result}: ${output}: ${error}")
endif()
foreach(mode IN ITEMS value-failure void-failure)
  execute_process(COMMAND "${PROBE}" "${mode}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 1 OR NOT error MATCHES "first diagnostic" OR error MATCHES "repeated factory evaluation")
    message(FATAL_ERROR "Fatal Result expression lost its first diagnostic (${mode}): ${result}: ${output}: ${error}")
  endif()
endforeach()
