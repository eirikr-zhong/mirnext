if(NOT DEFINED RUN OR NOT DEFINED REPORT)
  message(FATAL_ERROR "Native acceptance requires an executable and report path")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SourceFingerprint.cmake")
get_filename_component(source_dir "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
mirnext_source_fingerprint("${source_dir}" current_fingerprint)
if(NOT current_fingerprint STREQUAL SOURCE_FINGERPRINT)
  message(FATAL_ERROR "Native acceptance sources changed; rebuild before testing")
endif()
set(arguments --report "${REPORT}")
if(DEFINED EXPECTED AND NOT EXPECTED STREQUAL "")
  list(APPEND arguments --expected "${EXPECTED}")
endif()
execute_process(COMMAND "${RUN}" ${arguments} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Native acceptance failed (${status}):\n${output}\n${error}")
endif()
file(READ "${REPORT}" receipt)
if(NOT receipt MATCHES "\"schema\": 2" OR NOT receipt MATCHES "\"source_fingerprint\": \"${SOURCE_FINGERPRINT}\""
    OR NOT receipt MATCHES "\"configuration\": \"${CONFIGURATION}\"" OR NOT receipt MATCHES "\"linkage\": \"${LINKAGE}\""
    OR NOT receipt MATCHES "\"c_reference\": ${C_REFERENCE}" OR NOT receipt MATCHES "\"status\": \"passed\"" OR NOT receipt MATCHES "\"translated\": false"
    OR NOT receipt MATCHES "\"completed_scenes\": 21")
  message(FATAL_ERROR "Incomplete native acceptance receipt: ${receipt}")
endif()
foreach(mode original-interpreter optimized-interpreter eager lazy bbv mixed)
  if(NOT receipt MATCHES "\"mode\": \"${mode}\"")
    message(FATAL_ERROR "Missing native acceptance mode ${mode}")
  endif()
endforeach()
# Reject a valid but different ABI before creating any execution session. This
# also verifies that a previous successful receipt cannot survive a failed run.
if(receipt MATCHES "\"target\": \"aarch64-macos\"")
  set(wrong x86_64-sysv)
else()
  set(wrong aarch64-macos)
endif()
set(negative "${REPORT}.mismatch.json")
file(WRITE "${negative}" "${receipt}")
execute_process(COMMAND "${RUN}" --report "${negative}" --expected "${wrong}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 2)
  message(FATAL_ERROR "Wrong-target admission did not return a diagnostic (${status}): ${output} ${error}")
endif()
file(READ "${negative}" rejected)
if(NOT rejected MATCHES "\"status\": \"failed\"" OR NOT rejected MATCHES "\"completed_scenes\": 0"
    OR NOT rejected MATCHES "expected target")
  message(FATAL_ERROR "Wrong-target admission left a misleading receipt: ${rejected}")
endif()
message(STATUS "Native acceptance completed 21 scenes and rejected the mismatched target")
message(STATUS "Native acceptance source ${SOURCE_FINGERPRINT} configuration ${CONFIGURATION} linkage ${LINKAGE} c-reference ${C_REFERENCE}")
