# Native subprocess coverage. Each build tree owns all files; safe under CTest -j.
file(MAKE_DIRECTORY "${WORK}")
function(convert input output)
  execute_process(COMMAND "${M2B}" INPUT_FILE "${input}" OUTPUT_FILE "${output}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "m2b failed: ${status}: ${error}")
  endif()
endfunction()
function(check_array path)
  execute_process(COMMAND "${B2CTAB}" INPUT_FILE "${path}" OUTPUT_FILE "${path}.inc" RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "b2ctab failed: ${error}")
  endif()
  file(READ "${path}.inc" array)
  string(REGEX MATCHALL "0x[0-9a-f][0-9a-f]" hexbytes "${array}")
  file(READ "${path}" binary HEX)
  string(REPLACE "0x" "" arrayhex "${hexbytes}")
  string(REPLACE ";" "" arrayhex "${arrayhex}")
  if(NOT arrayhex STREQUAL binary OR NOT array MATCHES "static const uint8_t mir_code")
    message(FATAL_ERROR "embedded bytes differ from the canonical binary")
  endif()
endfunction()
file(WRITE "${WORK}/main.mir" [=[m:module
p:proto i32,p:message
import puts
main:func i64,i32:argc,p:argv,p:env
local i64:r,p:s
mov s,p:8(argv)
call p,puts,r,s
mov s,p:(env)
bfs invalid,s
ret argc
invalid:ret 99
endfunc
endmodule
]=])
convert("${WORK}/main.mir" "${WORK}/main.bmir")
execute_process(COMMAND "${B2M}" INPUT_FILE "${WORK}/main.bmir" OUTPUT_FILE "${WORK}/roundtrip.mir" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "b2m failed")
endif()
convert("${WORK}/roundtrip.mir" "${WORK}/roundtrip.bmir")
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${WORK}/main.bmir" "${WORK}/roundtrip.bmir" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "native command roundtrip is not canonical")
endif()
# Reconstruct the actual bytes instead of checking only an array declaration.
check_array("${WORK}/main.bmir")
set(large "large:module\nf:func i64\nlocal i64:r\n")
foreach(n RANGE 1 3000)
  string(APPEND large "mov r,${n}\n")
endforeach()
string(APPEND large "ret r\nendfunc\nendmodule\n")
file(WRITE "${WORK}/large.mir" "${large}")
convert("${WORK}/large.mir" "${WORK}/large.bmir")
check_array("${WORK}/large.bmir")
file(SIZE "${WORK}/large.bmir.inc" array_size)
if(array_size LESS 16384)
  message(FATAL_ERROR "large embedded fixture did not exercise output buffer boundaries")
endif()
get_filename_component(source_dir "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
foreach(n RANGE 1 16)
  convert("${source_dir}/mir-tests/test${n}.mir" "${WORK}/test${n}.bmir")
  execute_process(COMMAND "${B2M}" INPUT_FILE "${WORK}/test${n}.bmir" OUTPUT_FILE "${WORK}/test${n}.mir" RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "corpus b2m: ${n}: ${error}")
  endif()
  convert("${WORK}/test${n}.mir" "${WORK}/test${n}.roundtrip.bmir")
  # Text intentionally canonicalizes colliding local/symbol names (test13 has
  # a local named e beside function e). Compare the canonical text and then
  # its binary, rather than requiring original spelling to survive text.
  execute_process(COMMAND "${B2M}" INPUT_FILE "${WORK}/test${n}.roundtrip.bmir" OUTPUT_FILE "${WORK}/test${n}.roundtrip.mir" RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "canonical corpus b2m: ${n}: ${error}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${WORK}/test${n}.mir" "${WORK}/test${n}.roundtrip.mir" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "corpus command canonical text changed test${n}")
  endif()
  convert("${WORK}/test${n}.roundtrip.mir" "${WORK}/test${n}.canonical.bmir")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${WORK}/test${n}.roundtrip.bmir" "${WORK}/test${n}.canonical.bmir" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "corpus command canonical binary changed test${n}")
  endif()
endforeach()
foreach(mode interp gen lazy bbv)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "MIR_TYPE=${mode}" "MIR_LIBS=" "${RUN}" "${WORK}/main.bmir" program "argument payload"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  string(REPLACE "\r\n" "\n" output "${output}")
  if(NOT status EQUAL 2 OR NOT output STREQUAL "argument payload\n")
    message(FATAL_ERROR "${mode} main arguments/env/host binding: ${status}: ${output}: ${error}")
  endif()
endforeach()
# Resolve a bare library name through an explicit directory as well as a full
# path. These subprocesses also prove native artifacts retain the loader handles
# throughout eager/lazy/BBV calls.
get_filename_component(host_directory "${HOST}" DIRECTORY)
get_filename_component(host_name "${HOST}" NAME_WE)
string(REGEX REPLACE "^lib" "" host_name "${host_name}")
file(WRITE "${WORK}/foreign.mir" [=[m:module
p:proto i64,i64:a,i64:b
import mirnext_cli_add
main:func i64
local i64:r
call p,mirnext_cli_add,r,40,2
ret r
endfunc
endmodule
]=])
convert("${WORK}/foreign.mir" "${WORK}/foreign.bmir")
foreach(mode interp gen lazy bbv)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "MIR_TYPE=${mode}" "MIR_LIBS=${HOST}" "${RUN}" "${WORK}/foreign.bmir" program
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 42)
    message(FATAL_ERROR "${mode} custom library: ${status}: ${error}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env MIR_TYPE=lazy "MIR_LIB_DIRS=${host_directory}" "MIR_LIBS=${host_name}" "${RUN}" "${WORK}/foreign.bmir" program
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 42)
  message(FATAL_ERROR "library directory/name search: ${status}: ${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=MIR_TYPE "MIR_LIBS=${HOST}" "${RUN}" "${WORK}/foreign.bmir" program
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 42)
  message(FATAL_ERROR "default lazy execution: ${status}: ${error}")
endif()
file(WRITE "${WORK}/invalid" "not a MIR program")
foreach(tool "${M2B}" "${B2M}" "${B2CTAB}")
  execute_process(COMMAND "${tool}" INPUT_FILE "${WORK}/invalid" RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_VARIABLE output)
  if(status EQUAL 0 OR error STREQUAL "" OR NOT output STREQUAL "")
    message(FATAL_ERROR "format tool did not diagnose malformed input atomically: ${tool}")
  endif()
endforeach()
foreach(path "${WORK}/invalid" "${WORK}/not-present.bmir")
  execute_process(COMMAND "${RUN}" "${path}" program RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_VARIABLE output)
  if(status EQUAL 0 OR error STREQUAL "" OR NOT output STREQUAL "")
    message(FATAL_ERROR "runner input failure was not diagnosed: ${path}: ${status}: ${error}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env MIR_TYPE=invalid "${RUN}" "${WORK}/main.bmir" program RESULT_VARIABLE status ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT error MATCHES "unknown MIR_TYPE")
  message(FATAL_ERROR "runner accepted an invalid engine: ${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "MIR_LIBS=${WORK}/missing-library" "${RUN}" "${WORK}/foreign.bmir" program RESULT_VARIABLE status ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT error MATCHES "cannot load MIR library")
  message(FATAL_ERROR "runner accepted a missing library: ${error}")
endif()
function(reject_program name source diagnostic)
  file(WRITE "${WORK}/${name}.mir" "${source}")
  convert("${WORK}/${name}.mir" "${WORK}/${name}.bmir")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env MIR_TYPE=lazy "MIR_LIBS=" "${RUN}" "${WORK}/${name}.bmir" program
    RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_VARIABLE output)
  if(status EQUAL 0 OR NOT error MATCHES "${diagnostic}" OR NOT output STREQUAL "")
    message(FATAL_ERROR "${name} was not diagnosed: ${status}: ${error}: ${output}")
  endif()
endfunction()
reject_program(no-main "m:module\nf:func i64\nret 0\nendfunc\nendmodule\n" "without main")
reject_program(main-signature "m:module\nmain:func d\nret 0.0\nendfunc\nendmodule\n" "main requires")
reject_program(main-argument "m:module\nmain:func i64,p:a,p:b\nret 0\nendfunc\nendmodule\n" "main requires")
reject_program(duplicate-main "m:module\nmain:func i64\nret 0\nendfunc\nendmodule\nn:module\nmain:func i64\nret 0\nendfunc\nendmodule\n" "multiple main")
reject_program(unresolved "m:module\np:proto i64\nimport mirnext_missing_symbol_2381\nmain:func i64\nlocal i64:r\ncall p,mirnext_missing_symbol_2381,r\nret r\nendfunc\nendmodule\n" "cannot resolve host symbol")
reject_program(untyped "m:module\nimport puts\nmain:func i64\nlocal p:r\nmov r,puts\nret r\nendfunc\nendmodule\n" "requires a typed declaration")
reject_program(conflicting-prototypes "m:module\np:proto i64,i64:x\nq:proto i64,d:x\nimport puts\nmain:func i64\nlocal i64:r\ncall p,puts,r,0\ncall q,puts,r,0.0\nret r\nendfunc\nendmodule\n" "inconsistent call prototypes")
foreach(tool "${M2B}" "${B2M}" "${B2CTAB}" "${RUN}")
  execute_process(COMMAND "${tool}" unexpected RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_VARIABLE output)
  if(status EQUAL 0 OR NOT error MATCHES "usage:" OR NOT output STREQUAL "")
    message(FATAL_ERROR "command usage error: ${tool}: ${status}: ${error}")
  endif()
endforeach()
if(EXISTS "/dev/full")
  execute_process(COMMAND "${M2B}" INPUT_FILE "${WORK}/main.mir" OUTPUT_FILE "/dev/full" RESULT_VARIABLE status ERROR_VARIABLE error)
  if(status EQUAL 0 OR NOT error MATCHES "write failed")
    message(FATAL_ERROR "output failure was not diagnosed: ${status}: ${error}")
  endif()
endif()
message(STATUS "Native formats, embedded bytes, four engines, argv/env and shared symbols passed")
