execute_process(COMMAND "${EXPORT}" "--test-case=export*" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Native text fixture generation failed: ${status}\n${output}\n${errors}")
endif()
file(GLOB fixtures "${FIXTURES}/*.mir")
set(binary_ld_local_fixtures)
foreach(path IN LISTS fixtures)
  get_filename_component(name "${path}" NAME_WE)
  set(expected_modules 1)
  if(name MATCHES "^(simplified-|inlined-)?variables-cross-module$" OR name MATCHES "^inlined-private-" OR name STREQUAL "utility-scanner")
    set(expected_modules 2)
  endif()
  execute_process(COMMAND "${PROBE}" "${path}.bmir" 0 binary-scan RESULT_VARIABLE status OUTPUT_VARIABLE binary_snapshot ERROR_VARIABLE errors)
  if(NOT status EQUAL 0 AND errors MATCHES "Got 'ldouble', expected 'double'")
    message(STATUS "Original C reader retains raw LD local types on this target: ${path}; native roundtrip and canonical C binary checks remain enabled")
    set(binary_ld_local_limitation TRUE)
    list(APPEND binary_ld_local_fixtures "${name}")
  elseif(NOT status EQUAL 0 OR NOT binary_snapshot MATCHES "modules:${expected_modules}(\n|$)")
    message(FATAL_ERROR "C reader rejected native binary ${path}: ${status}\n${binary_snapshot}\n${errors}")
  else()
    set(binary_ld_local_limitation FALSE)
  endif()
  execute_process(COMMAND "${PROBE}" "${path}" 0 encode "${path}.c.bmir" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "C writer failed ${path}: ${status}\n${output}\n${errors}")
  endif()
  execute_process(COMMAND "${PROBE}" "${path}" 0 scan RESULT_VARIABLE status OUTPUT_VARIABLE snapshot ERROR_VARIABLE errors)
  if(NOT status EQUAL 0 OR NOT snapshot MATCHES "modules:${expected_modules}(\n|$)")
    message(FATAL_ERROR "C reader rejected native text ${path}: ${status}\n${snapshot}\n${errors}")
  endif()
  if(NOT binary_ld_local_limitation)
    string(REGEX MATCHALL "instruction:[^\n]+" text_instructions "${snapshot}")
    string(REGEX MATCHALL "instruction:[^\n]+" binary_instructions "${binary_snapshot}")
    if(NOT text_instructions STREQUAL binary_instructions)
      message(FATAL_ERROR "Operand snapshots differ between native text and binary ${path}:\n${text_instructions}\n${binary_instructions}")
    endif()
  endif()
  get_filename_component(name "${path}" NAME_WE)
  if(name MATCHES "^opcode-(.+)$")
    set(expected "${CMAKE_MATCH_1}")
    if(snapshot MATCHES "long-double-is-double:1")
      if(expected STREQUAL "d2ld" OR expected STREQUAL "ld2d")
        set(expected "dmov")
      elseif(expected MATCHES "ld")
        string(REPLACE "ld" "d" expected "${expected}")
      endif()
    endif()
    if(NOT snapshot MATCHES "opcode:${expected}=[1-9]")
      message(FATAL_ERROR "Native output lost opcode ${name}:\n${snapshot}")
    endif()
    if(binary_ld_local_limitation AND NOT snapshot MATCHES "long-double-is-double:1")
      message(FATAL_ERROR "Unexpected C long-double type failure on an extended-precision target")
    endif()
    if(NOT binary_ld_local_limitation AND NOT binary_snapshot MATCHES "opcode:${expected}=[1-9]")
      message(FATAL_ERROR "Native binary output lost opcode ${name}:\n${binary_snapshot}")
    endif()
  endif()
endforeach()
execute_process(COMMAND "${EXPORT}" "--test-case=import*" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Native reader rejected C binary: ${status}\n${output}\n${errors}")
endif()
foreach(path IN LISTS fixtures)
  get_filename_component(name "${path}" NAME_WE)
  set(expected_modules 1)
  if(name MATCHES "^(simplified-|inlined-)?variables-cross-module$" OR name MATCHES "^inlined-private-" OR name STREQUAL "utility-scanner")
    set(expected_modules 2)
  endif()
  execute_process(COMMAND "${PROBE}" "${path}.c.bmir" 0 binary-scan
    RESULT_VARIABLE status OUTPUT_VARIABLE original_snapshot ERROR_VARIABLE errors)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "C reader rejected its binary ${path}: ${status}\n${original_snapshot}\n${errors}")
  endif()
  execute_process(COMMAND "${PROBE}" "${path}.c.bmir.native" 0 binary-scan
    RESULT_VARIABLE status OUTPUT_VARIABLE snapshot ERROR_VARIABLE errors)
  if(NOT status EQUAL 0 OR NOT snapshot MATCHES "modules:${expected_modules}(\n|$)")
    message(FATAL_ERROR "C reader rejected native re-encoding of C binary ${path}: ${status}\n${snapshot}\n${errors}")
  endif()
  string(REGEX MATCHALL "instruction:[^\n]+" original_instructions "${original_snapshot}")
  string(REGEX MATCHALL "instruction:[^\n]+" reencoded_instructions "${snapshot}")
  if(NOT original_instructions STREQUAL reencoded_instructions)
    message(FATAL_ERROR "Native C-binary roundtrip changed instruction operands ${path}:\n${original_instructions}\n${reencoded_instructions}")
  endif()
endforeach()
foreach(name IN ITEMS loop layout scopes-branch scopes-switch scopes-indirect inlined-private-data inlined-private-function
    rewriter-fallthrough rewriter-branch rewriter-indirect rewriter-switch rewriter-label-data rewriter-scope
    calls-direct calls-indirect calls-block calls-rblk calls-variadic calls-variadic-block calls-results calls-inline
    variables-initialized variables-zero variables-constant variables-boolean variables-floating variables-pointer variables-expression variables-cross-module variables-narrow
    expressions-arithmetic expressions-unsigned expressions-narrow expressions-floating expressions-nan expressions-branch expressions-conversion expressions-memory expressions-call expressions-boolean expressions-initializer)
  set(execution_names "${name}")
  set(expected_result 42)
  if(name STREQUAL "inlined-private-function")
    set(expected_result 50)
  endif()
  if(name MATCHES "^(calls|variables|expressions)-")
    list(APPEND execution_names "simplified-${name}" "inlined-${name}")
  endif()
  foreach(execution_name IN LISTS execution_names)
  foreach(level RANGE 0 3)
    foreach(mode IN ITEMS interpret jit binary-interpret binary-jit)
      set(input "${FIXTURES}/${execution_name}.mir")
      if(mode MATCHES "^binary-")
        list(FIND binary_ld_local_fixtures "${execution_name}" ld_fixture)
        if(ld_fixture GREATER_EQUAL 0)
          set(input "${FIXTURES}/${execution_name}.mir.c.bmir")
          if(level EQUAL 0 AND mode STREQUAL "binary-interpret")
            message(STATUS "C execution uses its canonical binary for ${name}; native LD binary construction, decoding and the C-reader rejection were checked separately")
          endif()
        else()
          string(APPEND input ".bmir")
        endif()
      endif()
      execute_process(COMMAND "${PROBE}" "${input}" "${level}" "${mode}"
        RESULT_VARIABLE status OUTPUT_VARIABLE snapshot ERROR_VARIABLE errors)
      # Text/binary roundtrips above cover this fixture on every host. The C
      # Windows ABI rejects multiple results even in its interpreter shims;
      # require that diagnostic instead of invoking an unsupported native ABI.
      if(WIN32 AND name STREQUAL "calls-results" AND NOT status EQUAL 0
          AND errors MATCHES "Windows x86-64 doesn't support multiple return values")
        continue()
      endif()
      if(NOT status EQUAL 0 OR NOT snapshot MATCHES "result:i64=${expected_result}")
        message(FATAL_ERROR "Formatted ${name} changed execution at O${level} (${mode}): ${status}\n${snapshot}\n${errors}")
      endif()
    endforeach()
  endforeach()
  endforeach()
endforeach()
