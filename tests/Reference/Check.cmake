get_filename_component(fixture "${INPUT}" NAME_WE)
foreach(level RANGE 0 3)
  foreach(mode IN ITEMS jit interpret)
    execute_process(COMMAND "${PROBE}" "${INPUT}" "${level}" "${mode}"
      RESULT_VARIABLE status OUTPUT_VARIABLE snapshot ERROR_VARIABLE errors)
    if(NOT status EQUAL 0 OR NOT snapshot MATCHES "result:i64=42")
      message(FATAL_ERROR "Independent C oracle failed (${mode}, O${level}): ${status}\n${snapshot}\n${errors}")
    endif()
    if(mode STREQUAL "jit")
      if(NOT snapshot MATCHES "stage:simplify" OR NOT snapshot MATCHES "stage:build-cfg")
        message(FATAL_ERROR "Missing reference pipeline snapshots at O${level}")
      endif()
      if(level GREATER_EQUAL 2 AND NOT snapshot MATCHES "stage:gvn")
        message(FATAL_ERROR "Missing reference GVN snapshot at O${level}")
      endif()
      file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/reference-${fixture}-O${level}.snapshot" "${snapshot}")
    endif()
  endforeach()
endforeach()
