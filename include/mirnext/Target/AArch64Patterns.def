  {MIRNEXT_A64_OPCODE(And, AND), "r r r", "8a000000:ffe0fc00 rd0 rn1 rm2"},  /* and Rd,Rn,Rm */
  {MIRNEXT_A64_OPCODE(Ands, ANDS), "r r r", "0a000000:ffe0fc00 rd0 rn1 rm2"}, /* and Wd,Wn,Wm */

