  {MIRNEXT_A64_OPCODE(I2F, I2F), "r r", "9e220000:ffff0000 vd0 rn1"},  /* scvtf Sd,Rn */
  {MIRNEXT_A64_OPCODE(I2D, I2D), "r r", "9e620000:ffff0000 vd0 rn1"},  /* scvtf Dd,Rn */
  {MIRNEXT_A64_OPCODE(UI2F, UI2F), "r r", "9e230000:ffff0000 vd0 rn1"}, /* ucvtf Sd,Rn */
  {MIRNEXT_A64_OPCODE(UI2D, UI2D), "r r", "9e630000:ffff0000 vd0 rn1"}, /* ucvtf Dd,Rn */
  {MIRNEXT_A64_OPCODE(F2I, F2I), "r r", "9e380000:ffff0000 rd0 vn1"},  /* fcvtzs Rd,Sn */
  {MIRNEXT_A64_OPCODE(D2I, D2I), "r r", "9e780000:ffff0000 rd0 vn1"},  /* fcvtzs Rd,Dn */
  {MIRNEXT_A64_OPCODE(F2D, F2D), "r r", "1e22c000:fffffc00 vd0 vn1"},  /* fcvt Dd,Sn */
  {MIRNEXT_A64_OPCODE(D2F, D2F), "r r", "1e624000:fffffc00 vd0 vn1"},  /* fcvt Sd,Dn */
  // i2ld, ui2ld, ld2i, f2ld, d2ld, ld2f, ld2d are builtins

  {MIRNEXT_A64_OPCODE(Call, CALL), "X r $", "d63f0000:fffffc1f rn1"},   /* blr *Rn */
  {MIRNEXT_A64_OPCODE(Call, CALL), "X L $", "94000000:fc000000 rn1"},   /* bl address */
  {MIRNEXT_A64_OPCODE(Inline, INLINE), "X r $", "d63f0000:fffffc1f rn1"}, /* blr *Rn */
  {MIRNEXT_A64_OPCODE(Inline, INLINE), "X L $", "94000000:fc000000 rn1"}, /* bl address */
  {MIRNEXT_A64_OPCODE(Ret, RET), "$", "d65f0000:fffffc1f hn1e"},       /* ret R30  */

  {MIRNEXT_A64_OPCODE(JCall, JCALL), "X r $", "d61f0000:fffffc00 rn1"}, /* br r1 */
  {MIRNEXT_A64_OPCODE(JRet, JRET), "r $", "d61f0000:fffffc00 rn0"},    /* br r0  */

  /* add r0, r1, 15; and r0, r0, -16; sub sp, sp, r0; mov r0, sp: */
  {MIRNEXT_A64_OPCODE(Alloca, ALLOCA), "r r",
   "91003c00:fffffc00 rd0 rn1; 927cec00:fffffc00 rd0 rn0;"         /* add r0,r1,15;and r0,r0,-16
                                                                    */
   "cb206000:ffe0fc00 hn1f hd1f rm0; 91000000:fffffc00 rd0 hn1f"}, /* sub sp,sp,r0; mov r0,sp */
  /* sub sp, sp, roundup (imm, 16); mov r0, sp: */
  {MIRNEXT_A64_OPCODE(Alloca, ALLOCA), "r Iu", "d1000000:ff000000 hd1f hn1f Iu; 91000000:fffffc00 rd0 hn1f"},

  {MIRNEXT_A64_OPCODE(BStart, BSTART), "r", "91000000:fffffc00 rd0 hn1f"}, /* Rd = sp */
  {MIRNEXT_A64_OPCODE(BEnd, BEND), "r", "91000000:fffffc00 hd1f rn0"},   /* sp = Rn */

  /* adr r10,PC-relative TableAddress; ldr r10,(r10,r,8);br r10; TableContent
     We use r10 as r9 can be used if switch operand is memory. */
  {MIRNEXT_A64_OPCODE(Switch, SWITCH), "r $",
   "10000000:ff000000 hda T; f8607800:ffe0fc00 hda hna rm0; d61f0000:fffffc00 hna;"},

  /* Used only during machine code generation.  Should have the same format as branch on overflow
     insns */
  /* unsigned sub sets up carry flag when there is no overflow: */
  {MIRNEXT_A64_OPCODE(SubUnsignedOverflow, SUB_UBO), "l", "54000003:ff00001f l"},  /* b.cc */
  {MIRNEXT_A64_OPCODE(SubUnsignedNoOverflow, SUB_UBNO), "l", "54000002:ff00001f l"}, /* b.cs */

  /* MULOS:smull Rd,Wn,Wm; asr r10,Rd,32; cmp W10,Wd,asr 31 */
  {MIRNEXT_A64_OPCODE(Mulos, MULOS), "r r r",
   "9b207c00:ffe0fc00 rd0 rn1 rm2; 9340fc00:ffc0fc00 hda rn0 I20; "
   "6b80001f:ffe0001f hna rm0 i1f"},
  /* UMULOS:umull Rd,Wn,Wm; cmp xzr,Rd,lsr 32 */
  {MIRNEXT_A64_OPCODE(UMulos, UMULOS), "r r r", "9ba07c00:ffe0fc00 rd0 rn1 rm2; eb40001f:ffe0001f hn1f rm0 i20"},
  /* MULO:smulh h11,Rn,Rm; mul Rd,Rn,Rm; cmp h11,Rd,asr 63 (r11 is a scratch reg) */
  {MIRNEXT_A64_OPCODE(Mulo, MULO), "r r r",
   "9b407c00:ffe0fc00 hdb rn1 rm2; 9b007c00:ffe0fc00 rd0 rn1 rm2; "
   "eb80001f:ffe0001f hnb rm0 i3f"},
  /* UMULO:umulh h11,Rn,Rm; mul Rd,Rn,Rm; cmp xzr,h11 (r11 is a scratch reg) */
  {MIRNEXT_A64_OPCODE(UMulo, UMULO), "r r r",
   "9bc07c00:ffe0fc00 hdb rn1 rm2; 9b007c00:ffe0fc00 rd0 rn1 rm2; "
   "eb00001f:ff20001f hn1f hmb"},

  /* [u]mulo[s] insns uses zero flag to check overflow: */
  {MIRNEXT_A64_OPCODE(MultiplyOverflow, MUL_BO), "l", BNE},  /* b.ne */
  {MIRNEXT_A64_OPCODE(MultiplyNoOverflow, MUL_BNO), "l", BEQ}, /* b.eq */
