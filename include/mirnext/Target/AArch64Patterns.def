  // ??? with shift
  {MIRNEXT_A64_OPCODE(Neg, NEG), "r r", "cb0003e0:ff2003e0 rd0 rm1"},  /* neg Rd,Rm */
  {MIRNEXT_A64_OPCODE(Negs, NEGS), "r r", "4b0003e0:ff2003e0 rd0 rm1"}, /* neg Wd,Wm */
  {MIRNEXT_A64_OPCODE(FNeg, FNEG), "r r", "1e214000:fffffc00 vd0 vn1"}, /* fneg Sd,Sn */
  {MIRNEXT_A64_OPCODE(DNeg, DNEG), "r r", "1e614000:fffffc00 vd0 vn1"}, /* fneg Dd,Dn */
  // ldneg is a builtin

  {MIRNEXT_A64_OPCODE(Lsh, LSH), "r r r", "9ac02000:ffe0fc00 rd0 rn1 rm2"},  /* lsl Rd,Rn,Rm */
  {MIRNEXT_A64_OPCODE(Lshs, LSHS), "r r r", "1ac02000:ffe0fc00 rd0 rn1 rm2"}, /* lsl Wd,Wn,Wm */
  {MIRNEXT_A64_OPCODE(Lsh, LSH), "r r SL", "d3400000:ffc00000 rd0 rn1 SL"},  /* ubfm Rd,Rn,immr,imms */
  {MIRNEXT_A64_OPCODE(Lshs, LSHS), "r r Sl", "53000000:ffc00000 rd0 rn1 Sl"}, /* ubfm Wd,Wn,immr,imms */

  {MIRNEXT_A64_OPCODE(Rsh, RSH), "r r r", "9ac02800:ffe0fc00 rd0 rn1 rm2"},  /* asr Rd,Rn,Rm */
  {MIRNEXT_A64_OPCODE(Rshs, RSHS), "r r r", "1ac02800:ffe0fc00 rd0 rn1 rm2"}, /* asr Wd,Wn,Wm */
  {MIRNEXT_A64_OPCODE(Rsh, RSH), "r r SR", "9340fc00:ffc0fc00 rd0 rn1 S"},   /* asr Rd,Rn,S */
  {MIRNEXT_A64_OPCODE(Rshs, RSHS), "r r Sr", "13007c00:ffc0fc00 rd0 rn1 S"},  /* asr Wd,Wn,S */

  {MIRNEXT_A64_OPCODE(URsh, URSH), "r r r", "9ac02400:ffe0fc00 rd0 rn1 rm2"},  /* lsr Rd,Rn,Rm */
  {MIRNEXT_A64_OPCODE(URshs, URSHS), "r r r", "1ac02400:ffe0fc00 rd0 rn1 rm2"}, /* lsr Wd,Wn,Wm */
  {MIRNEXT_A64_OPCODE(URsh, URSH), "r r SR", "d340fc00:ffc0fc00 rd0 rn1 S"},   /* lsr Rd,Rn,S */
  {MIRNEXT_A64_OPCODE(URshs, URSHS), "r r Sr", "53007c00:ffc0fc00 rd0 rn1 S"},  /* lsr Wd,Wn,S */

