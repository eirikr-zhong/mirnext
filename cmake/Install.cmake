cmake_minimum_required(VERSION 3.14)
include("${CMAKE_CURRENT_LIST_DIR}/InstallReceipt.cmake")
if(NOT DEFINED BINARY_DIR OR NOT DEFINED PREFIX)
  message(FATAL_ERROR "BINARY_DIR and PREFIX are required")
endif()
mirnext_absolute_path("${BINARY_DIR}" binary)
mirnext_absolute_path("${PREFIX}" prefix)
set(destination "${prefix}")
set(staging "")
if(NOT "${STAGING_ROOT}" STREQUAL "")
  if(WIN32)
    message(FATAL_ERROR "DESTDIR staging is not supported by CMake on Windows")
  endif()
  mirnext_absolute_path("${STAGING_ROOT}" staging)
  mirnext_absolute_path("${staging}${prefix}" destination)
endif()
if(NOT DEFINED CONFIG)
  set(CONFIG Release)
endif()
set(previous_paths)
if(EXISTS "${binary}/mirnext-install-receipt.txt")
  mirnext_read_receipt("${binary}/mirnext-install-receipt.txt" previous_root previous_paths)
  set(old_comparison "${previous_root}")
  set(new_comparison "${destination}")
  if(WIN32)
    string(TOLOWER "${old_comparison}" old_comparison)
    string(TOLOWER "${new_comparison}" new_comparison)
  endif()
  if(NOT old_comparison STREQUAL new_comparison)
    foreach(path IN LISTS previous_paths)
      if(EXISTS "${path}" OR IS_SYMLINK "${path}")
        message(FATAL_ERROR "Uninstall the previous native installation before selecting a different destination")
      endif()
    endforeach()
    set(previous_paths)
  endif()
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DESTDIR=${staging}"
  "${CMAKE_COMMAND}" --install "${binary}" --config "${CONFIG}" --prefix "${prefix}"
  RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Native installation failed: ${status}")
endif()
file(READ "${binary}/install_manifest.txt" manifest)
if(manifest MATCHES "[\r;]")
  message(FATAL_ERROR "Invalid characters in the installation manifest")
endif()
string(REPLACE "\n" ";" entries "${manifest}")
set(paths)
foreach(path IN LISTS entries)
  if(path STREQUAL "")
    continue()
  endif()
  if(NOT IS_ABSOLUTE "${path}")
    message(FATAL_ERROR "Relative install manifest path: ${path}")
  endif()
  mirnext_absolute_path("${path}" logical)
  mirnext_path_within("${prefix}" "${logical}" within)
  if(NOT within)
    message(FATAL_ERROR "Install manifest path is outside the selected prefix: ${path}")
  endif()
  if(NOT "${STAGING_ROOT}" STREQUAL "")
    mirnext_absolute_path("${staging}${logical}" logical)
  endif()
  list(APPEND paths "${logical}")
endforeach()
list(APPEND paths ${previous_paths})
list(REMOVE_DUPLICATES paths)
mirnext_validate_installation("${destination}" ${paths})
set(receipt "MIRNext install receipt v1\n${destination}\n")
foreach(path IN LISTS paths)
  string(APPEND receipt "${path}\n")
endforeach()
file(WRITE "${binary}/mirnext-install-receipt.txt.tmp" "${receipt}")
file(RENAME "${binary}/mirnext-install-receipt.txt.tmp" "${binary}/mirnext-install-receipt.txt")
message(STATUS "Recorded native installation at ${destination}")
