function(mir_target_cxx_options target)
  target_compile_features(${target} PRIVATE cxx_std_20)
  if(MIRNEXT_ENABLE_ASAN)
    target_compile_options(${target} PRIVATE -fsanitize=address -fno-omit-frame-pointer)
    target_link_options(${target} PRIVATE -fsanitize=address)
  endif()
  if(MSVC)
    set(rtti_option /GR-)
    if(ARGV1 STREQUAL "WITH_RTTI")
      set(rtti_option /GR)
    endif()
    target_compile_definitions(${target} PRIVATE _HAS_EXCEPTIONS=0)
    target_compile_options(${target} PRIVATE /EHs-c- ${rtti_option})
  else()
    set(rtti_option -fno-rtti)
    if(ARGV1 STREQUAL "WITH_RTTI")
      set(rtti_option -frtti)
    endif()
    target_compile_options(${target} PRIVATE -fno-exceptions ${rtti_option})
  endif()
endfunction()

if(MIRNEXT_ENABLE_ASAN AND NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
  message(FATAL_ERROR "MIRNEXT_ENABLE_ASAN requires GCC or Clang on a supported native platform")
endif()
