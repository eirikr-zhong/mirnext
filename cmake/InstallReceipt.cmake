# Shared path checks for the native installation receipt. CMake 3.14 syntax.
function(mirnext_absolute_path input output)
  if("${input}" STREQUAL "" OR "${input}" MATCHES "[\r\n;]")
    message(FATAL_ERROR "Invalid installation path: '${input}'")
  endif()
  get_filename_component(path "${input}" ABSOLUTE)
  if(WIN32)
    string(REPLACE "\\" "/" path "${path}")
  endif()
  set(${output} "${path}" PARENT_SCOPE)
endfunction()

function(mirnext_read_receipt input output_root output_paths)
  if(NOT EXISTS "${input}")
    message(FATAL_ERROR "No native installation receipt; run make install first")
  endif()
  file(READ "${input}" contents)
  if(contents MATCHES "[\r;]")
    message(FATAL_ERROR "Invalid characters in the installation receipt")
  endif()
  string(REPLACE "\n" ";" lines "${contents}")
  list(LENGTH lines count)
  if(count LESS 2)
    message(FATAL_ERROR "Incomplete native installation receipt")
  endif()
  list(GET lines 0 version)
  if(NOT version STREQUAL "MIRNext install receipt v1")
    message(FATAL_ERROR "Unknown native installation receipt format")
  endif()
  list(GET lines 1 prefix)
  if(NOT IS_ABSOLUTE "${prefix}")
    message(FATAL_ERROR "Installation receipt prefix must be absolute")
  endif()
  mirnext_absolute_path("${prefix}" prefix)
  list(REMOVE_AT lines 0 1)
  set(paths)
  foreach(path IN LISTS lines)
    if(NOT path STREQUAL "")
      list(APPEND paths "${path}")
    endif()
  endforeach()
  mirnext_validate_installation("${prefix}" ${paths})
  set(${output_root} "${prefix}" PARENT_SCOPE)
  set(${output_paths} "${paths}" PARENT_SCOPE)
endfunction()

function(mirnext_path_within root path output)
  set(comparison_root "${root}")
  set(comparison_path "${path}")
  if(WIN32)
    string(TOLOWER "${comparison_root}" comparison_root)
    string(TOLOWER "${comparison_path}" comparison_path)
  endif()
  string(FIND "${comparison_path}" "${comparison_root}/" position)
  if(comparison_path STREQUAL comparison_root OR position EQUAL 0)
    set(${output} TRUE PARENT_SCOPE)
  else()
    set(${output} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(mirnext_validate_installation root)
  if("${root}" STREQUAL "/" OR "${root}" MATCHES "^[A-Za-z]:/$")
    message(FATAL_ERROR "An installation receipt cannot own a filesystem root")
  endif()
  get_filename_component(real_root "${root}" REALPATH)
  foreach(path IN LISTS ARGN)
    if(NOT IS_ABSOLUTE "${path}")
      message(FATAL_ERROR "Installation receipt contains a relative path: ${path}")
    endif()
    mirnext_absolute_path("${path}" normalized)
    mirnext_path_within("${root}" "${normalized}" within)
    if(NOT within OR normalized STREQUAL root)
      message(FATAL_ERROR "Installation receipt path is outside its prefix: ${path}")
    endif()
    if(IS_DIRECTORY "${path}" AND NOT IS_SYMLINK "${path}")
      message(FATAL_ERROR "Installation receipt must list files, not directories: ${path}")
    endif()
    # Removing an installed symlink is fine; following a parent-directory
    # symlink outside the installation would remove someone else's file.
    get_filename_component(parent "${normalized}" DIRECTORY)
    get_filename_component(real_parent "${parent}" REALPATH)
    mirnext_path_within("${real_root}" "${real_parent}" parent_within)
    if(NOT parent_within)
      message(FATAL_ERROR "Installation receipt parent escapes its prefix: ${path}")
    endif()
  endforeach()
endfunction()
