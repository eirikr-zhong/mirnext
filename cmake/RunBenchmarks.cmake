if(WIN32)
  set(suffix .exe)
endif()
if(EXISTS "${BINARY_DIR}/Release/mirnext_classic_benchmark${suffix}")
  set(BINARY_DIR "${BINARY_DIR}/Release")
endif()
foreach(workload loop sieve)
  execute_process(COMMAND "${BINARY_DIR}/mirnext_classic_benchmark${suffix}" "--${workload}" --quick RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Native ${workload} benchmark failed: ${status}")
  endif()
endforeach()
execute_process(COMMAND "${BINARY_DIR}/mirnext_format_io_benchmark${suffix}" --functions 32 RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Native format benchmark failed: ${status}")
endif()
